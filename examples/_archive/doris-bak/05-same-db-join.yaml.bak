source:
  type: doris
  connection:
    url: jdbc:mysql://127.0.0.1:9030/consilens_demo?useUnicode=true&characterEncoding=UTF-8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
    username: ${env.DORIS_USER}
    password: ${env.DORIS_PASSWORD}
  resource:
    type: table
    name: orders
target:
  type: doris
  connection:
    url: jdbc:mysql://127.0.0.1:9030/consilens_demo?useUnicode=true&characterEncoding=UTF-8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
    username: ${env.DORIS_USER}
    password: ${env.DORIS_PASSWORD}
  resource:
    type: table
    name: orders_backup
comparison:
  keys:
    source: [order_id]
    target: [order_id]
  fields:
    source: [order_id, customer_id, amount, status, created_at]
    target: [order_id, customer_id, amount, status, created_at]
strategy:
  mode: join
  localCompare:
    mode: row-hash
  maxDifferences: 10000
normalization:
  decimal:
    precision: 4
    rounding: true
  float:
    precision: 6
    rounding: true
  date:
    format: yyyy-MM-dd
  time:
    format: HH:mm:ss
  datetime:
    format: yyyy-MM-dd HH:mm:ss
    timezone: Asia/Shanghai
  timestamp:
    format: yyyy-MM-dd HH:mm:ss
    timezone: Asia/Shanghai
  binary:
    encoding: uppercase
  boolean:
    trueValue: "1"
    falseValue: "0"
  varchar:
    nullValue: "\\N"
result:
  sinks:
    - format: console
      type: result
    - format: csv
      type: diff-record
      properties: |
        {
          "path": "./output/doris-orders-diff.csv"
        }
    - format: console
      type: result
      enabled: false
